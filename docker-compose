services:
  verdillian-music:
    image: verdillian/verdillian-music:latest
    restart: unless-stopped
    ports:
      - "4000:4000"
    environment:
      NODE_ENV: production
      PORT: 4000
      DATA_DIR: /data
      NAVIDROME_URL: ${NAVIDROME_URL}
      LIDARR_URL: ${LIDARR_URL:-}
      LIDARR_API_KEY: ${LIDARR_API_KEY:-}
      SERVER_SECRET: ${SERVER_SECRET}
      JWT_SECRET: ${JWT_SECRET}
    volumes:
      - verdillian_data:/data

volumes:
  verdillian_data:
